(version 1.10.2)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml fmt astring cmdliner re)))

(source
 (fetch
  (url
   https://github.com/mirage/alcotest/releases/download/1.10.2/alcotest-1.10.2.tbz)
  (checksum
   sha512=fadb58647cb046624e54a08da873e1abdf56fedc3f5f6c9d91a851e4f83a688e451ba087e8100976bfcbe8d6374dd2e6db718f175483e0a825e0acba7be3a3d1)))
