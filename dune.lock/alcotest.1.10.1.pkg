(version 1.10.1)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune ocaml fmt astring cmdliner re)))

(source
 (fetch
  (url
   https://github.com/mirage/alcotest/releases/download/1.10.1/alcotest-1.10.1.tbz)
  (checksum
   sha512=6f779fa96faf96b5b462ddc428aeaaa73a6be96771dbbad6a05b7bb00dae246648891c211e26174729c1f40128410ad96f2512101ae8b7d61f968ee61534b3d0)))
